{
  "manifest_version": 2,
  "id": "com.khiqwq.owner-auth-plugin",
  "version": "2.0.1",
  "name": "主人身份验证插件 (Owner Authentication Plugin)",
  "description": "为麦麦机器人提供用户身份验证功能，支持多用户独立配置，自定义提示词模板，兼容MaiBot 1.0.0+",
  "author": {
    "name": "DavidBlackCN",
    "url": "https://github.com/DavidBlackCN"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/DavidBlackCN/maibot-owner-auth-plugin",
    "homepage": "https://github.com/DavidBlackCN/maibot-owner-auth-plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "typing-extensions",
      "version_spec": ">=4.8.0"
    }
  ],
  "capabilities": [
    "send_message"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales"
  }
}