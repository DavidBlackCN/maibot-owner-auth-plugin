{
  "manifest_version": 2,
  "id": "davidblackcn.maibot-maiidentity-plugin",
  "version": "3.3.0",
  "name": "MaiIdentity",
  "description": "固定身份称呼与相处提示，按消息作者匹配名单，并为 MaiVita 提供管理权限查询。",
  "author": {
    "name": "DavidBlackCN",
    "url": "https://github.com/DavidBlackCN"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/DavidBlackCN/maibot-maiidentity-plugin",
    "homepage": "https://github.com/DavidBlackCN/maibot-maiidentity-plugin"
  },
  "host_application": {
    "min_version": "1.3.12",
    "max_version": "1.3.18"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.19.0"
  },
  "dependencies": [],
  "capabilities": [
    "message.get_by_id",
    "chat.get_all_streams",
    "component.list_loaded_plugins",
    "send.text"
  ],
  "plugin_type": "extension",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ],
    "locales_path": "_locales"
  }
}
